# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=

# Twilio WhatsApp — leave blank to run stub-safe (sends are logged, not sent).
# See docs/NOTIFICATIONS.md for how to get these, including the free
# WhatsApp Sandbox for development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Pick ONE of these two ways to send. If both are set, the Messaging
# Service wins (Twilio picks the sender from its pool; TWILIO_WHATSAPP_NUMBER
# is ignored). Leave both blank to run stub-safe.
#
# Messaging Service — recommended. The service's Sender Pool must have a
# WhatsApp-capable sender added (Console > Messaging > Services > Senders);
# an SMS-only Long Code sender in the pool does NOT enable WhatsApp sending.
TWILIO_MESSAGING_SERVICE_SID=
# Direct number — simpler, no Messaging Service needed. Your single
# WhatsApp-enabled Twilio number, e.g. whatsapp:+14155238886.
TWILIO_WHATSAPP_NUMBER=

# Approved WhatsApp Message Templates (Twilio Console > Messaging > Content
# Editor) — bypass the 24h customer-service window entirely, unlike
# everything above which sends as freeform text. Each is optional and
# independent: set one once Meta approves it, leave the rest blank until
# theirs comes through. Content SID looks like HX...
TWILIO_TEMPLATE_JOB_ASSIGNED_SID=
TWILIO_TEMPLATE_ORDER_IN_PRODUCTION_SID=
TWILIO_TEMPLATE_ORDER_READY_FOR_PICKUP_SID=
TWILIO_TEMPLATE_ORDER_OUT_FOR_DELIVERY_SID=
TWILIO_TEMPLATE_ADMIN_ORDER_STATUS_CHANGED_SID=

# Delivery-status tracking (app/api/twilio/whatsapp/status) — set to this
# app's own production URL and Twilio will call back with delivered/read/
# failed updates for every message sent. Leave blank to skip: messages
# still send, they just stay at "sent" and never update further. Also used
# as the exact URL the webhook validates Twilio's request signature
# against, so it must match verbatim.
TWILIO_STATUS_CALLBACK_URL=https://primeflowboard.netlify.app/api/twilio/whatsapp/status

# Optional — used to fill {companyName}/{pickupLocation}/{pickupHours} in
# message templates (lib/notifications/templates.ts). Defaults shown.
COMPANY_NAME=Prime Printing Co.
PICKUP_LOCATION=Prime Printing Co. — Shuwaikh Industrial, Kuwait
PICKUP_HOURS=9:00 AM – 5:00 PM

# Web Push (lock-screen notifications for staff). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The public key must be set TWICE — once server-side and once with the
# NEXT_PUBLIC_ prefix so the browser can subscribe with it. Leave blank to
# disable push entirely; WhatsApp notifications are unaffected.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact address push services use to reach the operator about problems.
VAPID_SUBJECT=mailto:reemprimeco@gmail.com

# Shared secret required in the Authorization header of /api/cron/* routes
# (month-end archival, retry-notifications)
CRON_SECRET=

# WooCommerce auto-import (app/api/webhooks/woocommerce). Must match the
# Secret set on the webhook in WooCommerce: Settings > Advanced > Webhooks,
# Topic "Order created", Delivery URL
# https://primeflowboard.netlify.app/api/webhooks/woocommerce
# Leave blank to disable the endpoint entirely (it rejects every request).
WOOCOMMERCE_WEBHOOK_SECRET=
# The store's hostname (no scheme, no trailing slash) — the ONLY host the
# import will download customer artwork from. Leave blank to skip artwork
# entirely; orders still import, they just arrive without design files.
WOOCOMMERCE_STORE_HOST=primeprint.com.kw

# Armada delivery integration (app/api/webhooks/armada). ARMADA_API_KEY comes
# from the Armada dashboard: Automated Ordering > your key > "Show secret".
# ARMADA_WEBHOOK_KEY is NOT from Armada -- generate any random 12-32 char
# string yourself (e.g. `openssl rand -hex 16`) and paste the same value into
# Armada's "Order update webhook" setup as a shared secret. Leave either
# blank to disable Armada dispatch entirely -- orders set to that provider
# fall back to notifying internal delivery staff instead. See
# docs/ARMADA_DELIVERY.md.
ARMADA_API_KEY=
ARMADA_WEBHOOK_KEY=
ARMADA_ENV=production

# Dev-only: bypasses auth and serves static demo data instead of Supabase.
# Never set this to true in production. See lib/demo/mode.ts. Keep the two
# flags in sync — NEXT_PUBLIC_DEMO_MODE is the client-visible copy that
# stops the browser from attempting real Supabase Realtime connections.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
