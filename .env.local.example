# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=

# Twilio WhatsApp — leave blank to run stub-safe (sends are logged, not sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Shared secret required in the Authorization header of /api/cron/month-end
CRON_SECRET=

# Dev-only: bypasses auth and serves static demo data instead of Supabase.
# Never set this to true in production. See lib/demo/mode.ts.
DEMO_MODE=false
