# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie signing secret — generate with: openssl rand -base64 32
SESSION_SECRET=

# Twilio WhatsApp — leave blank to run stub-safe (sends are logged, not sent).
# See docs/NOTIFICATIONS.md for how to get these, including the free
# WhatsApp Sandbox for development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Delivery-status tracking (app/api/twilio/whatsapp/status) — set to this
# app's own production URL and Twilio will call back with delivered/read/
# failed updates for every message sent. Leave blank to skip: messages
# still send, they just stay at "sent" and never update further. Also used
# as the exact URL the webhook validates Twilio's request signature
# against, so it must match verbatim.
TWILIO_STATUS_CALLBACK_URL=https://primeflowboard.netlify.app/api/twilio/whatsapp/status

# Optional — used to fill {companyName}/{pickupLocation} in message
# templates (lib/notifications/templates.ts). Defaults shown.
COMPANY_NAME=Prime Printing Co.
PICKUP_LOCATION=Prime Printing Co. — Shuwaikh Industrial, Kuwait

# Shared secret required in the Authorization header of /api/cron/* routes
# (month-end archival, retry-notifications)
CRON_SECRET=

# Dev-only: bypasses auth and serves static demo data instead of Supabase.
# Never set this to true in production. See lib/demo/mode.ts. Keep the two
# flags in sync — NEXT_PUBLIC_DEMO_MODE is the client-visible copy that
# stops the browser from attempting real Supabase Realtime connections.
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false
